{
  "extends": "@suwon-web-front/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "@types"
  ],
  "exclude": ["node_modules", "dist"]
}
