{
  "name": "@suwon-web-front/ui",
  "description": "ui for React and tailwindcss, Shadcn",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/modern/index.d.mts",
        "default": "./dist/modern/index.mjs"
      },
      "require": {
        "types": "./dist/modern/index.d.ts",
        "default": "./dist/modern/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "dist/legacy/index.d.ts",
  "main": "dist/legacy/index.js",
  "module": "dist/legacy/index.mjs",
  "scripts": {
    "build": "tsup",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx ./src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx ./src --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "ui": "pnpm dlx shadcn@latest",
    "prettier": "prettier --write './src/**/*.{ts,tsx,js,jsx}'"
    
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@suwon-web-front/eslint-config": "workspace:^",
    "@suwon-web-front/typescript-config": "workspace:*",
    "@suwon-web-front/ui-tailwind": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@turbo/gen": "^2.5.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "clsx": "^2.1.1",
    "globals": "^16.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^1.0.0",
    "tsup": "latest",
    "typescript": "5.8.2",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.7",
    "tailwindcss-animate": "^1.0.7"
  }
}
